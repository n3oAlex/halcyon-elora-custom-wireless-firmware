menuconfig EC11_CLASSIC
    bool "Upstream-ZMK two-line EC11 driver (Halcyon encoder rev 1.0)"
    default y
    depends on DT_HAS_HALCYON_EC11_CLASSIC_ENABLED
    depends on GPIO
    help
      Vendored copy of upstream ZMK's EC11 driver, kept separate from the splitkb fork's rewrite.

if EC11_CLASSIC

choice EC11_CLASSIC_TRIGGER_MODE
    prompt "Trigger mode"
    default EC11_CLASSIC_TRIGGER_GLOBAL_THREAD
    help
      Specify the type of triggering to be used by the driver.

config EC11_CLASSIC_TRIGGER_NONE
    bool "No trigger"

config EC11_CLASSIC_TRIGGER_GLOBAL_THREAD
    bool "Use global thread"
    depends on GPIO
    select EC11_CLASSIC_TRIGGER

config EC11_CLASSIC_TRIGGER_OWN_THREAD
    bool "Use own thread"
    depends on GPIO
    select EC11_CLASSIC_TRIGGER

endchoice

config EC11_CLASSIC_TRIGGER
    bool

config EC11_CLASSIC_THREAD_PRIORITY
    int "Thread priority"
    depends on EC11_CLASSIC_TRIGGER_OWN_THREAD
    default 10
    help
      Priority of thread used by the driver to handle interrupts.

config EC11_CLASSIC_THREAD_STACK_SIZE
    int "Thread stack size"
    depends on EC11_CLASSIC_TRIGGER_OWN_THREAD
    default 1024
    help
      Stack size of thread used by the driver to handle interrupts.

endif # EC11_CLASSIC